{
  "name": "onyva",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter mobile dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm --filter mobile build && pnpm --filter invite build",
    "dev:all": "pnpm --parallel --filter mobile --filter invite dev",
    "dev:local": "node scripts/local-stack.mjs",
    "local:venues": "node scripts/local-stack.mjs venues",
    "local:stations": "node scripts/local-stack.mjs stations",
    "test:local": "tsx scripts/check-local-engine.ts",
    "db:push": "supabase db push",
    "live:local:configure": "node scripts/configure-local.mjs",
    "supabase:start": "supabase start --exclude studio,imgproxy,logflare,vector,supavisor",
    "supabase:functions": "supabase functions serve --env-file supabase/functions/.env.local",
    "test:live": "playwright test --config playwright.live.config.ts",
    "deploy:supabase": "node scripts/deploy-supabase.mjs",
    "live:check": "node scripts/check-live.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "venues:import": "TZ=Europe/Paris tsx scripts/venues/import.ts",
    "stations:import": "tsx scripts/import-stations.ts",
    "test:database": "tsx tests/database/live.test.ts",
    "test:location": "tsx tests/location-http.ts",
    "prim:record": "tsx scripts/record-prim.ts",
    "test:manual": "tsx scripts/check-manual-live.ts",
    "engine:build-network": "tsx scripts/engine/build-network.ts",
    "engine:bench": "node --expose-gc --import tsx scripts/engine/bench.ts",
    "engine:dev": "pnpm --filter @onyva/engine dev",
    "engine:bench-http": "tsx scripts/engine/bench-http.ts",
    "engine:record-references": "tsx scripts/engine/record-references.ts",
    "engine:import-stations": "tsx scripts/engine/import-stations.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "supabase": "2.122.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6",
    "opening_hours": "^3.15.0",
    "@onyva/shared": "workspace:*",
    "@onyva/transit-engine": "workspace:*"
  },
  "type": "module"
}
