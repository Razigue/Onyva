{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "packages/**/*.ts",
    "apps/engine/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "apps/invite/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile/dist"
  ]
}
