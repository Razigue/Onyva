# Application Expo : ces valeurs sont publiques.
# Copier dans apps/mobile/.env.local ou dans l’environnement de build EAS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_INVITE_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
# Chemin du fichier Firebase fourni à EAS pour Android.
GOOGLE_SERVICES_FILE=

# Serveur et imports uniquement. Ne jamais utiliser le préfixe EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIM_API_KEY=
# Aucun quota gratuit supposé. Renseigner le plafond confirmé dans le compte PRIM.
PRIM_DAILY_LIMIT=
# Plafond quotidien par personne, 100 par défaut, jamais au-dessus du plafond partagé.
PRIM_USER_DAILY_LIMIT=100
PRIM_QUOTA_CONFIRMED=false
LOCATION_SIGNING_SECRET=
NOTIFICATIONS_SECRET=
# Facultatif, si la sécurité renforcée Expo Push est activée.
EXPO_ACCESS_TOKEN=

# Import hebdomadaire OSM, sans Overpass.
TZ=Europe/Paris
OSM_VENUES_FILE=/tmp/onyva-venues.jsonl

# Déploiement Supabase CLI uniquement.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Page d’invitation : identifiants publics.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
APPLE_APP_ID=
ANDROID_CERT_FINGERPRINT=
VITE_IOS_STORE_URL=
VITE_ANDROID_STORE_URL=

# Captures réelles de référence, facultatives, après import du catalogue PRIM.
PRIM_FIXTURE_ORIGIN_IDS=
PRIM_FIXTURE_DESTINATION_ID=
PRIM_FIXTURE_MEETING_AT=
PRIM_FIXTURE_ENDS_AT=

# Désactiver la recherche automatique pendant sa mise en attente.
RECOMMENDATIONS_ENABLED=false

# Déploiement des invitations, valeurs à configurer dans GitHub Actions.
# Ne jamais exposer le jeton Cloudflare dans le bundle Vite ou Expo.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
